{
  "name": "stellopay-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --quiet",
    "lint:all": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check:env": "tsx scripts/check-env-sync.ts",
    "check:migrations": "tsx scripts/lint-migrations.ts",
    "check:docs": "tsx scripts/check-docs-links.ts",
    "prestart": "pnpm build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation:test": "stryker run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:load": "tsx scripts/load/rate-limit-soak.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rate-limit-redis": "^6.0.1",
    "starknet": "^10.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autocannon": "^7.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  }
}
